# ── Core ─────────────────────────────────────────────────────────────────────
# Prisma datasource (PostgreSQL). Locally `npm run db:local` starts a zero-install Postgres
# that matches this URL; in production use your host's connection string
# (Vercel: Storage › Neon or Prisma Postgres fills it in automatically).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/rcc"
# 32+ random bytes, base64. Used to sign short-lived tokens.
SESSION_SECRET=""
# 32 random bytes, base64. Encrypts 2FA secrets, seller tax ids and payout details at rest.
APP_ENCRYPTION_KEY=""
# Shared secret for /api/jobs/run (cron-driven job runner on serverless hosts).
JOBS_SECRET=""
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`; set it to the same value or its own.
CRON_SECRET=""
# Public origin of the site (canonical URLs, emails, payment return URLs).
NEXT_PUBLIC_SITE_URL="https://rarecomicscollectors.com"

# ── Uploads ──────────────────────────────────────────────────────────────────
# Long-running servers: files go to this writable directory (served through /api/media).
UPLOAD_DIR="./uploads"
# Serverless (Vercel): create a Blob store under Storage; its token switches uploads to
# object storage automatically.
BLOB_READ_WRITE_TOKEN=""

# ── Bootstrap super admin (used by the seed, which also runs during `npm run build`) ──
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-before-seeding"

# ── Admin hardening (optional) ───────────────────────────────────────────────
# Comma-separated IPs / CIDR prefixes allowed to reach /admin. Empty = no restriction.
ADMIN_IP_ALLOWLIST=""
# Set to "false" on serverless hosts: jobs then run after each request and from the cron.
JOBS_INLINE_WORKER=""

# ── Email (optional; without SMTP, mail is recorded in the admin Email log only) ──
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="Rare Comics Collectors <no-reply@rarecomicscollectors.com>"

# ── Payment providers (secrets live here, never in the database) ─────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# sandbox | live
PAYPAL_ENV="sandbox"

# ── Exchange rates (optional; frankfurter.app needs no key) ──────────────────
EXCHANGE_RATE_API_URL="https://api.frankfurter.app/latest"
