{
  "name": "rcc-gocollect-scraper",
  "version": "1.0.0",
  "description": "Scrapes recent comic sales from GoCollect.com and outputs a WooCommerce-ready CSV.",
  "main": "gocollect-scraper.js",
  "scripts": {
    "scrape": "node gocollect-scraper.js",
    "scrape:golden": "node gocollect-scraper.js --era golden",
    "scrape:silver": "node gocollect-scraper.js --era silver"
  },
  "dependencies": {
    "csv-writer": "1.6.0",
    "puppeteer": "22.15.0"
  },
  "engines": {
    "node": ">=18"
  }
}
